# Frontend environment. Copy to `.env` for local development (never commit it).
# Every VITE_ variable is baked into the JavaScript bundle at build time and is
# public: never put a key or secret here. Changing a value needs a new build
# (on Vercel: redeploy).

# Backend API base URL, including the version prefix, no trailing slash.
# Local: http://localhost:3000/api/v1
# Vercel (Production and Preview): https://<backend-domain>/api/v1
#   e.g. https://qalab-api.vercel.app/api/v1
# The backend must allow this frontend's origin (CORS_ORIGIN / CORS_ORIGIN_PATTERN).
VITE_API_BASE_URL=http://localhost:3000/api/v1
