# Backend environment. Copy to `.env` for local development (never commit it).
# On Vercel, set the same names in Project → Settings → Environment Variables;
# the "Vercel:" lines below give the production values. Everything is validated
# at startup (src/config/env.validation.ts): the API refuses to boot when a
# value is missing or invalid.

# --- Runtime -----------------------------------------------------------------

# development | test | production. Vercel: production
NODE_ENV=development
# Local port only. Vercel: leave unset (the platform provides it)
PORT=3000

# --- Browser access (CORS) ---------------------------------------------------

# Comma-separated list of exact allowed origins (scheme + host, no path).
# Vercel: https://<frontend-domain>, plus any custom domain, e.g.
#   https://qalab-web.vercel.app,https://qalab.example.com
CORS_ORIGIN=https://qalab-web.vercel.app
# Optional. One regular expression for more origins, typically the frontend's
# Vercel preview deployments. Must be anchored ^https://…$ (checked at startup).
# Vercel URL format: <project>-<hash>-<scope>.vercel.app and
# <project>-git-<branch>-<scope>.vercel.app, e.g.
#   ^https://qalab-web-[a-z0-9-]+-satomijins-projects\.vercel\.app$
# Leave empty locally and to allow production only.
CORS_ORIGIN_PATTERN=http://localhost:5173

# Where auth emails (verify email, reset password) send the user.
# Vercel: https://<frontend-domain> (the production frontend, also for previews)
FRONTEND_URL=https://qalab-web.vercel.app

# --- API docs ----------------------------------------------------------------

# Swagger UI at /api/docs. Vercel: false (unless the docs should be public)
SWAGGER_ENABLED=true

# --- Rate limits -------------------------------------------------------------

# Requests per minute per IP for each /auth/* endpoint
AUTH_RATE_LIMIT=5
# Attempt submissions per minute per user
ATTEMPT_RATE_LIMIT=20
# Reverse proxies in front of the API, so rate limits see the client IP.
# 0 locally. Vercel (and Render / Railway / Fly): 1
TRUST_PROXY_HOPS=0
