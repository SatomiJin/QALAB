# Runtime
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Used for auth email redirect links (verify email, reset password)
FRONTEND_URL=http://localhost:5173

# Swagger UI at /api/docs
SWAGGER_ENABLED=true

# Requests per minute per IP for each /auth/* endpoint
AUTH_RATE_LIMIT=5
# Reverse proxies in front of the API (1 on Render/Railway/Fly), 0 locally
TRUST_PROXY_HOPS=0

# Supabase (local: `npm run db:status`, cloud: Project Settings -> API)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Backend only. Never expose this key to the frontend or in any response.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Google Cloud Translation API (v2) key for Vietnamese lesson content.
# Needs billing enabled on the Google Cloud project; restrict the key to the
# Cloud Translation API. Without it, lessons are shown in English.
GOOGLE_TRANSLATE_API_KEY=
